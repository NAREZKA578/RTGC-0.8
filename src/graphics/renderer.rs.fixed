    pub fn draw_text(&mut self, t: &str, x: f32, y: f32, s: f32, c: [f32; 4]) {
        // Заглушка - требует bitmap шрифт
    }
                if let Some(u_color) = self.gl.get_uniform_location(ui_shader.program(), "u_color")
                {
                    self.gl.uniform_4_f32_slice(Some(&u_color), &c);
                }

                // Рисуем прямоугольник через TRIANGLE_STRIP (4 вершины)
                let vertices: [f32; 16] = [
                    x,
                    y,
                    0.0,
                    0.0,
                    c[0],
                    c[1],
                    c[2],
                    c[3], // v0
                    x + w,
                    y,
                    1.0,
                    0.0,
                    c[0],
                    c[1],
                    c[2],
                    c[3], // v1
                    x,
                    y + h,
                    0.0,
                    1.0,
                    c[0],
                    c[1],
                    c[2],
                    c[3], // v2
                    x + w,
                    y + h,
                    1.0,
                    1.0,
                    c[0],
                    c[1],
                    c[2],
                    c[3], // v3
                ];

                if let Some(vao) = self.ui_vao {
                    self.gl.bind_vertex_array(Some(vao));
                    self.gl
                        .bind_buffer(glow::ARRAY_BUFFER, Some(self.ui_vbo.unwrap()));
                    self.gl
                        .buffer_data_slice(glow::ARRAY_BUFFER, &vertices, glow::DYNAMIC_DRAW);

                    let pos_loc = self
                        .gl
                        .get_attrib_location(ui_shader.program(), "a_position");
                    let color_loc = self.gl.get_attrib_location(ui_shader.program(), "a_color");
                    let uv_loc = self.gl.get_attrib_location(ui_shader.program(), "a_uv");

                    if let Some(loc) = pos_loc {
                        self.gl.enable_vertex_attrib_array(loc);
                        self.gl.vertex_attrib_pointer_f32(loc, 2, false, 8 * 4, 0);
                    }
                    if let Some(loc) = color_loc {
                        self.gl.enable_vertex_attrib_array(loc);
                        self.gl
                            .vertex_attrib_pointer_f32(loc, 4, false, 8 * 4, 2 * 4);
                    }
                    if let Some(loc) = uv_loc {
                        self.gl.enable_vertex_attrib_array(loc);
                        self.gl
                            .vertex_attrib_pointer_f32(loc, 2, false, 8 * 4, 6 * 4);
                    }

                    self.gl.draw_arrays(glow::TRIANGLE_STRIP, 0, 4);
                }
            }

            self.gl.enable(glow::DEPTH_TEST);
        }
    }

    pub fn draw_rect_border(&mut self, x: f32, y: f32, w: f32, h: f32, b: f32, c: [f32; 4]) {
        // Рисуем 4 линии вокруг прямоугольника
        let c_alpha = [c[0], c[1], c[2], c[3]];
        self.draw_rect(x, y, w, b, c); // top
        self.draw_rect(x, y + h - b, w, b, c); // bottom
        self.draw_rect(x, y, b, h, c); // left
        self.draw_rect(x + w - b, y, b, h, c); // right
    }

